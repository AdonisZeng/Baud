#include <windows.h>
#include "src\\Version.h"

IDI_ICON1 ICON "resources\\Baud.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION BAUD_VERSION_MAJOR,BAUD_VERSION_MINOR,BAUD_VERSION_PATCH,0
 PRODUCTVERSION BAUD_VERSION_MAJOR,BAUD_VERSION_MINOR,BAUD_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AdonisZeng"
            VALUE "FileDescription", "Baud - VOFA+ Serial Host"
            VALUE "FileVersion", BAUD_VERSION_STRING
            VALUE "InternalName", "Baud"
            VALUE "LegalCopyright", "Copyright (C) 2026 AdonisZeng"
            VALUE "OriginalFilename", "Baud.exe"
            VALUE "ProductName", "Baud"
            VALUE "ProductVersion", BAUD_VERSION_STRING
            VALUE "Comments", "GPL-3.0-or-later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
